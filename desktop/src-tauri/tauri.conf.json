{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cyber Clinic",
  "version": "0.3.0",
  "identifier": "org.cyberclinic.community",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "sprite",
        "title": "Cyber Clinic",
        "url": "index.html",
        "width": 640,
        "height": 520,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; media-src 'self' data: blob: asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "万有智流（杭州）科技发展有限责任公司",
    "resources": {
      "../../NOTICE": "NOTICE"
    },
    "targets": [
      "nsis",
      "app"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    }
  },
  "plugins": {}
}
